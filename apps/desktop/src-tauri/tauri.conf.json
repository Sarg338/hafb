{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HAFB",
  "identifier": "app.hafb.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HAFB",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#f3f3f3",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "HAFB",
    "copyright": "MIT License",
    "shortDescription": "Here's A Free Budget",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../LICENSE": "LICENSE.txt",
      "../../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "fileAssociations": [
      {
        "ext": ["hafb"],
        "name": "HAFB plan",
        "description": "HAFB plan",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "1c28ff98-a600-55b8-89eb-89a19e51ee75"
      }
    }
  }
}
