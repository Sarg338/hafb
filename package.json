{
  "name": "hafb",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @hafb/desktop tauri dev",
    "test": "pnpm -r test",
    "test:engine": "pnpm --filter @hafb/engine test",
    "lint": "pnpm run lint:tsc && pnpm run lint:eslint && pnpm run lint:clippy",
    "lint:tsc": "pnpm -r typecheck",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:clippy": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "build": "pnpm --filter @hafb/desktop tauri build && node scripts/build-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
