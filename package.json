{
  "name": "hafb",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @hafb/desktop tauri dev",
    "test": "pnpm -r test",
    "test:engine": "pnpm --filter @hafb/engine test",
    "lint": "pnpm run lint:tsc && pnpm run lint:eslint && pnpm run lint:clippy",
    "lint:tsc": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:clippy": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --workspace",
    "build": "pnpm --filter @hafb/desktop tauri build && node scripts/build-report.mjs",
    "smoke": "node --experimental-strip-types --no-warnings --test --test-concurrency=1 apps/desktop/smoke/app.smoke.ts",
    "smoke:build": "pnpm build && pnpm smoke",
    "import:ynab": "node --experimental-strip-types --no-warnings scripts/import-ynab.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
